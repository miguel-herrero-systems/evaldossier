{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/evaluation-request.schema.json",
  "title": "EvalDossier evaluation request 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "schemaVersion",
    "requestId",
    "operation",
    "createdAt",
    "expiresAt",
    "requester",
    "signingKeyId",
    "targetEvaluatorId",
    "profile",
    "statement",
    "criteria",
    "artifacts",
    "privacy",
    "economicBoundary",
    "signatureContext",
    "proof"
  ],
  "properties": {
    "protocolVersion": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/protocolVersion" },
    "schemaVersion": { "const": "evaldossier.evaluation-request/0.1" },
    "requestId": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/identifier" },
    "operation": { "enum": ["EVALUATE", "NORMALIZE"] },
    "createdAt": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/timestamp" },
    "requester": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/embeddedSigner" },
    "signingKeyId": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/keyId" },
    "targetEvaluatorId": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/identifier" },
    "profile": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/profileRef" },
    "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "predicateId", "required", "statement", "parameters"],
        "properties": {
          "criterionId": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/identifier" },
          "predicateId": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/identifier" },
          "required": { "type": "boolean" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "parameters": {
            "description": "Closed, ordered name/value parameters avoid open JSON objects in the signed request envelope.",
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/identifier" },
                "value": { "type": ["string", "boolean", "integer", "null"] }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/artifactCommitment" }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "trainingUse"],
      "properties": {
        "classification": { "enum": ["PUBLIC_SYNTHETIC", "PUBLIC_CAPTURE_SANITIZED"] },
        "trainingUse": { "const": false }
      }
    },
    "economicBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentExecution", "paymentRecommendation"],
      "properties": {
        "paymentExecution": { "const": "OUT_OF_SCOPE" },
        "paymentRecommendation": { "const": "OUT_OF_SCOPE" }
      }
    },
    "signatureContext": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/signatureContext" },
    "proof": { "$ref": "https://raw.githubusercontent.com/miguel-herrero-systems/evaldossier/v0.1.0/schemas/common.schema.json#/$defs/proof" }
  }
}
