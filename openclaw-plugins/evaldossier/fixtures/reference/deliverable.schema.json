{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportId", "subject", "findings"],
  "properties": {
    "reportId": { "type": "string", "pattern": "^report-[0-9]{4}-[0-9]{3}$" },
    "subject": { "const": "agent-payment-evidence" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^finding-[0-9]{3}$" },
          "status": { "enum": ["confirmed", "rejected", "inconclusive"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
